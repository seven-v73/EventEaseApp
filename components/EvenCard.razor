@using EventEaseApp.Models

<div class="card h-100 shadow-sm border-0">
    <div class="card-body">
        <h5 class="card-title text-primary">@EventData.Title</h5>
        <p class="card-text text-muted mb-1">
            <strong>📅 Date:</strong> @EventData.Date.ToShortDateString()
        </p>
        <p class="card-text text-muted mb-2">
            <strong>📍 Location:</strong> @EventData.Location
        </p>
        <p class="card-text">@EventData.Description</p>
        
        <!-- Two-Way Data Binding Requirement (@bind) -->
        <div class="mt-3 p-2 bg-light rounded">
            <label class="form-label font-weight-bold">Update Event Title (Two-Way Bound):</label>
            <input class="form-control" @bind="EventData.Title" @bind:event="oninput" />
        </div>
    </div>
    <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center pb-3">
        <a href="/event/@EventData.Id" class="btn btn-outline-primary btn-sm">View Details</a>
    </div>
</div>

@code {
    [Parameter]
    public EventModel EventData { get; set; } = new EventModel();
}